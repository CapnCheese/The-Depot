#pragma kernel CSMain

StructuredBuffer<float4x4> _InputTransforms;
AppendStructuredBuffer<float4x4> _OutputTransforms;

float3 _CameraPos;
float _MinDistance;
float _MaxDistance;
int _InstanceCount;
float4 _FrustumPlanes[6];

bool IsInFrustum(float3 pos)
{
    for (int i = 0; i < 5; i++)
    {
        if(dot(_FrustumPlanes[i].xyz, pos) + _FrustumPlanes[i].w < -0.5)
            return false;
    }
    return true;
}

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_InstanceCount) return;

    float4x4 mat = _InputTransforms[id.x];
    float3 pos = float3(mat[0][3], mat[1][3], mat[2][3]);

    float dist = distance(pos, _CameraPos);

    if(dist < _MinDistance)
    {
        _OutputTransforms.Append(mat);
        return;
    }

    if (dist < _MaxDistance && IsInFrustum(pos))
        _OutputTransforms.Append(mat);
}
